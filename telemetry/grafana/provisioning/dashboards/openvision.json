{
  "uid": "openvision-main",
  "title": "OpenVision",
  "tags": [
    "openvision"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "openvision-influx"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"metrics\", tag: \"model\")",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": false
        }
      },
      {
        "name": "tts",
        "label": "TTS engine",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "openvision-influx"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"metrics\", tag: \"tts\")",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": false
        }
      }
    ]
  },
  "panels": [
    {
      "id": 99,
      "type": "row",
      "title": "Health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Turn success rate",
      "description": "RED's Errors. A turn is a failure when it ends without delivering audio \u2014 interrupted, superseded, or errored. A dashboard that only shows latency cannot tell a fast failure from a fast success.",
      "datasource": {
        "type": "influxdb",
        "uid": "openvision-influx"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "#EAB839",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openvision-influx"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.model =~ /^${model:regex}$/)\n  |> filter(fn: (r) => r.tts =~ /^${tts:regex}$/)\n  |> filter(fn: (r) => r._measurement == \"turn\" and r._field == \"succeeded\")\n  |> keep(columns: [\"_value\"])\n  |> mean()\n  |> map(fn: (r) => ({r with _value: r._value * 100.0}))"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Turns / min",
      "description": "RED's Rate. Usage volume \u2014 context for every other number here.",
      "datasource": {
        "type": "influxdb",
        "uid": "openvision-influx"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
