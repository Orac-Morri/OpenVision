{
  "uid": "openvision-main",
  "title": "OpenVision",
  "tags": ["openvision"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Perceived latency",
      "description": "Silence between the user finishing speaking and the reply starting. The number that decides whether the assistant feels fast.",
      "datasource": { "type": "influxdb", "uid": "openvision-influx" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "custom": { "drawStyle": "points", "pointSize": 8, "lineWidth": 1, "showPoints": "always" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 2 },
              { "color": "red", "value": 4 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "openvision-influx" },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"turn\" and r._field == \"perceived_latency_s\")\n  |> keep(columns: [\"_time\", \"_value\", \"model\"])\n  |> rename(columns: {_value: \"perceived\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Where the time goes",
      "description": "commit = endpointing · ttft = backend think time · generation = decode · tts = synthesis lead-in. Whichever dominates is the thing worth optimising.",
      "datasource": { "type": "influxdb", "uid": "openvision-influx" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "openvision-influx" },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"turn\")\n  |> filter(fn: (r) => r._field == \"commit_s\" or r._field == \"ttft_s\" or r._field == \"generation_s\" or r._field == \"tts_lead_in_s\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latest perceived latency",
      "datasource": { "type": "influxdb", "uid": "openvision-influx" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 2 },
              { "color": "red", "value": 4 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "openvision-influx" },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"turn\" and r._field == \"perceived_latency_s\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tokens / sec",
      "description": "On-device decode rate. Only reported by the local MLX backend.",
      "datasource": { "type": "influxdb", "uid": "openvision-influx" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "#EAB839", "value": 10 },
              { "color": "green", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "openvision-influx" },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"turn\" and r._field == \"tokens_per_second\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Thermal state",
      "description": "iOS gives four buckets, not degrees: 0 nominal · 1 fair · 2 serious · 3 critical.",
      "datasource": { "type": "influxdb", "uid": "openvision-influx" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "max": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 1 },
              { "color": "orange", "value": 2 },
              { "color": "red", "value": 3 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "nominal", "index": 0 },
                "1": { "text": "fair", "index": 1 },
                "2": { "text": "serious", "index": 2 },
                "3": { "text": "critical", "index": 3 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "openvision-influx" },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device\" and r._field == \"thermal_level\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Jetsam headroom",
      "description": "Memory left before iOS SIGKILLs the app. A kill leaves no crash log, so this is the early warning.",
      "datasource": { "type": "influxdb", "uid": "openvision-influx" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 500 },
              { "color": "#EAB839", "value": 1000 },
              { "color": "green", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "openvision-influx" },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device\" and r._field == \"memory_available_mb\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory",
      "description": "App footprint against remaining jetsam headroom. Two on-device models loaded at once is what killed the app before.",
      "datasource": { "type": "influxdb", "uid": "openvision-influx" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "openvision-influx" },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device\")\n  |> filter(fn: (r) => r._field == \"memory_footprint_mb\" or r._field == \"memory_available_mb\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU",
      "description": "This app's threads summed across cores, so above 100% is normal during inference. iOS exposes no per-core clocks.",
      "datasource": { "type": "influxdb", "uid": "openvision-influx" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "openvision-influx" },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device\" and r._field == \"cpu_percent\")\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"cpu\"})"
        }
      ]
    }
  ]
}
