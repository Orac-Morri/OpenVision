    {
      "id": 9,
      "type": "table",
      "title": "Per-model summary",
      "description": "Mean of each stage, split by the model that ACTUALLY served the turn. Use this to compare models rather than eyeballing the scatter.",
      "datasource": {
        "type": "influxdb",
        "uid": "openvision-influx"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openvision-influx"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.model =~ /^${model:regex}$/)\n  |> filter(fn: (r) => r._measurement == \"turn\")\n  |> filter(fn: (r) => r._field == \"perceived_latency_s\" or r._field == \"ttft_s\" or r._field == \"generation_s\")\n  |> group(columns: [\"model\", \"_field\"])\n  |> mean()\n  |> keep(columns: [\"model\", \"_field\", \"_value\"])\n  |> pivot(rowKey: [\"model\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        }
      ]
    },
