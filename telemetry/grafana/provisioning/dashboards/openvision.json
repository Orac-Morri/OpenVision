    {
      "id": 6,
      "type": "gauge",
      "title": "Thermal state",
      "description": "iOS exposes four buckets, not degrees. Sustained on-device inference pushes this up, and throttling shows up as slower turns.",
      "datasource": {
        "type": "influxdb",
        "uid": "openvision-influx"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "nominal",
                  "index": 0
                },
                "1": {
                  "text": "fair",
                  "index": 1
                },
                "2": {
                  "text": "serious",
                  "index": 2
                },
                "3": {
                  "text": "critical",
                  "index": 3
                }
              }
            }
          ],
          "min": 0,
          "max": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openvision-influx"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device\" and r._field == \"thermal_level\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Jetsam headroom",
      "description": "Memory left before iOS kills the app. A kill leaves no crash log, so this is the early warning.",
      "datasource": {
        "type": "influxdb",
        "uid": "openvision-influx"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
